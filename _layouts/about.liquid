---
layout: default
---
<div class="post home-editorial">
  <section class="home-hero" aria-labelledby="home-name">
    <div class="home-hero-identity">
      <h1 class="home-display-name" id="home-name">
        {% if site.title == 'blank' %}
          {{ site.first_name }}
          {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <p class="home-name-pronunciation">Pronounced: Meow You</p>
      <p class="home-position">Assistant Professor of Information Systems</p>
      <p class="home-institution">
        <span class="home-institution-college">College of Business</span>
        <span class="home-institution-separator" aria-hidden="true"> · </span>
        <span class="home-institution-university">City University of Hong Kong</span>
      </p>
    </div>

    <div class="home-hero-research">
      <div class="home-hero-summary">
        <p>My research centers on two areas:</p>
        <ul class="home-research-areas">
          <li>
            <strong>Agentic AI Systems:</strong> Designing explainable and domain-adapted AI for decision-making in financial services and the public
            sector.
          </li>
          <li>
            <strong>Digital Platforms:</strong> Examining the effects of algorithmic design on consumer behavior, worker welfare, and platform performance.
          </li>
        </ul>
      </div>
      <nav class="home-profile-links" aria-label="Academic and contact links">
        <a href="https://www.linkedin.com/in/miao-y-86a492118/" target="_blank" rel="noopener noreferrer"
          ><i class="ti ti-brand-linkedin" aria-hidden="true"></i> LinkedIn</a
        >
        <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" target="_blank" rel="noopener noreferrer"
          ><i class="ti ti-school" aria-hidden="true"></i> Google Scholar</a
        >
        <a href="https://papers.ssrn.com/sol3/cf_dev/AbsByAuth.cfm?per_id=4796013" target="_blank" rel="noopener noreferrer"
          ><i class="ti ti-book-2" aria-hidden="true"></i> SSRN</a
        >
        <a href="mailto:{{ site.email }}"><i class="ti ti-mail" aria-hidden="true"></i> Email</a>
      </nav>
    </div>

    {% if page.profile and page.profile.image %}
      <div class="home-portrait">
        <div class="home-portrait-frame">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% capture portrait_sizes %}(min-width: 992px) 304px, (min-width: 761px) 256px, 256px{% endcapture %}
          {% include figure.liquid loading="eager" path=profile_image_path sizes=portrait_sizes alt="Portrait of Miao Yu" cache_bust=true %}
        </div>
      </div>
    {% endif %}
  </section>

  {{ content }}
</div>
