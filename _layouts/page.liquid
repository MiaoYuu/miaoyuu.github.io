---
layout: default
---
<div class="post{% if page.permalink == '/Teaching/' %} post-teaching{% elsif page.permalink == '/Research/' %} post-research{% endif %}">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% assign clean_description = page.description | default: '' | strip %}
    {% if clean_description != '' %}
      <p class="post-description">{{ clean_description }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
